{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/app/**",
              "ui_kits/empresas_web/**",
              "ui_kits/personas_web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow|Inter))/i]",
        "message": "Font not provided by the design system. Available: Barlow, Inter."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--alerta",
      "--alerta-bg",
      "--azul-claro",
      "--azul-entel",
      "--azul-negocios",
      "--bg-1",
      "--bg-2",
      "--bg-3",
      "--bg-brand",
      "--bg-brand-strong",
      "--blanco",
      "--error",
      "--error-bg",
      "--exito",
      "--exito-bg",
      "--fg-1",
      "--fg-2",
      "--fg-3",
      "--fg-brand",
      "--fg-on-brand",
      "--font-body",
      "--font-display",
      "--font-ui",
      "--gris-010",
      "--gris-100",
      "--gris-200",
      "--gris-600",
      "--gris-900",
      "--icon-lg",
      "--icon-md",
      "--icon-sm",
      "--icon-xl",
      "--line",
      "--line-strong",
      "--naranjo-entel",
      "--negro",
      "--radius-lg",
      "--radius-md",
      "--radius-pill",
      "--radius-sm",
      "--radius-xs",
      "--shadow-focus",
      "--shadow-lg",
      "--shadow-md",
      "--shadow-sm",
      "--space-1",
